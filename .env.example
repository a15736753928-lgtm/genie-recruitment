# Database
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/genie_recruitment
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/genie_recruitment

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# App
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Upload (留空则使用项目根目录下的 uploads 文件夹)
# UPLOAD_DIR=
MAX_UPLOAD_SIZE=52428800

# Milvus Lite
MILVUS_DB_PATH=milvus_lite.db
EMBEDDING_DIM=1536

# Root User
ROOT_USERNAME=admin
ROOT_PASSWORD=change-me
